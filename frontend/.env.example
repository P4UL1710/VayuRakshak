# Server-only URL. Browsers call same-origin /api; this URL is never bundled.
# Local development:
BACKEND_URL=http://127.0.0.1:9000
# Deployed frontend: use your backend's HTTPS URL.
# Docker Compose injects http://backend:4000 instead.
BACKEND_TIMEOUT_MS=5000
# Keeps the hackathon usable if the API is offline. Response is labelled fallback.
DEMO_FALLBACK_ENABLED=true
# Optional narration bridge. Never use NEXT_PUBLIC for provider credentials.
EDGE_TTS_URL=http://127.0.0.1:8001/synthesize
EDGE_TTS_TOKEN=
# Future integration placeholders; not active simply by setting credentials.
AWS_REGION=ap-south-1
AWS_PROTECTION_TABLE=
AWS_PROTECTION_STATE_MACHINE_ARN=
AWS_SCHEDULER_ROLE_ARN=
BEDROCK_MODEL_ID=
EMBEDDINGS_PROVIDER=local-keyword
VECTOR_STORE_PROVIDER=local
# Persistent account/session store for one Node instance. Mount this directory in production.
# Multi-instance AWS deployments should replace the store with Cognito + DynamoDB.
# AUTH_DATA_DIR=/path/to/persistent/auth-data
# Set the exact public HTTPS origin behind a reverse proxy (CSRF checks and Secure cookies).
# APP_ORIGIN=https://your-site.example
