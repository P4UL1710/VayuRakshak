# Server-only URL. Browsers call same-origin /api; this URL is never bundled.
# Local development:
BACKEND_URL=http://127.0.0.1:4000
# Deployed frontend: use your backend's HTTPS URL.
# Docker Compose injects http://backend:4000 instead.
BACKEND_TIMEOUT_MS=5000
# Keeps the hackathon usable if the API is offline. Response is labelled fallback.
DEMO_FALLBACK_ENABLED=true
