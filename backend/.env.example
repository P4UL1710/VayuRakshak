# Backend runtime configuration (copy to backend/.env for local development).
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Restrict cross-origin requests. Frontend proxy uses server-to-server requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_MODE=demo
MAX_BODY_BYTES=16384
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

# Server-only credentials. Never prefix secrets with NEXT_PUBLIC_.
# The MVP uses deterministic demo adapters; credentials alone do not enable live actions.
WAQI_TOKEN=
CPCB_API_URL=
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
NASA_FIRMS_MAP_KEY=
ML_FORECAST_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
IFTTT_WEBHOOK_KEY=
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
WEARABLE_API_URL=
